[Unit]
Description=whisper.cpp transcription server (Voxtype remote backend)
After=network.target

[Service]
# Model: e.g. ggml-large-v3-turbo.bin from huggingface.co/ggerganov/whisper.cpp
ExecStart=/usr/bin/whisper-server -m %h/.local/share/whisper-server/models/ggml-large-v3-turbo.bin --host 127.0.0.1 --port 9000 --inference-path /v1/audio/transcriptions -l en
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
